# Local development: copy to .env.local. On Cloudflare, secrets go in with `npx wrangler secret put NAME`.
AUTH_SECRET=            # 32+ random characters (signs the admin cookie)
SYNC_SECRET=            # 16+ random characters (lets the cron trigger and `npm run sync` call /api/sync)
ADMIN_PASSWORD=         # 12+ characters
NEXT_PUBLIC_SITE_URL=http://localhost:3001
SYNC_URL=http://localhost:3001   # only for `npm run sync`
# NEXT_PUBLIC_INDEXING=on        # leave unset: search engines stay out until the client says go
